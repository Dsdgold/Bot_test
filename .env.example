# ═══════════════════════════════════════════════════════
#  AI Trading Agent Configuration
# ═══════════════════════════════════════════════════════

# MEXC API Keys (get from https://www.mexc.com/user/openapi)
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here

# Trading Settings
TRADING_SYMBOL=BTC_USDT
TRADING_LEVERAGE=20
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
MIN_CONFIDENCE=65

# Mode: true = paper trading (no real money), false = live trading
PAPER_TRADING=true

# Dashboard
DASHBOARD_PORT=8001
LOG_LEVEL=INFO
