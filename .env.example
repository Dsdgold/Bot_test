# ═══════════════════════════════════════════════════════
#  AI Trading Agent Configuration
# ═══════════════════════════════════════════════════════

# Claude AI (Anthropic) - powers intelligent trading decisions
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MEXC API Keys (get from https://www.mexc.com/user/openapi)
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# AI Model (claude-sonnet-4-20250514 for speed, claude-opus-4-20250514 for best analysis)
AI_MODEL=claude-sonnet-4-20250514
# How often AI analyzes (every N ticks, lower = more API calls)
AI_ANALYSIS_INTERVAL=3
# Use AI to decide when to close positions too
AI_CLOSE_DECISIONS=true

# Trading Settings
TRADING_SYMBOL=BTC_USDT
TRADING_LEVERAGE=20
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
MIN_CONFIDENCE=65

# Mode: true = paper trading (no real money), false = live trading
PAPER_TRADING=true

# Dashboard
DASHBOARD_PORT=8001
LOG_LEVEL=INFO
