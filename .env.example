# ═══════════════════════════════════════════════════════
#  AI Trading Agent Configuration
# ═══════════════════════════════════════════════════════

# Claude AI (Anthropic) - powers intelligent trading decisions
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bybit API Keys (get from https://www.bybit.com/app/user/api-management)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
# Set to true to use Bybit testnet (paper trading with real API)
BYBIT_TESTNET=false

# AI Model (claude-sonnet-4-20250514 for speed, claude-opus-4-20250514 for best analysis)
# AI Model: claude-haiku-4-5-20251001 (cheapest), claude-sonnet-4-20250514 (balanced), claude-opus-4-20250514 (best)
AI_MODEL=claude-haiku-4-5-20251001
# How often AI analyzes (every N ticks, lower = more API calls)
AI_ANALYSIS_INTERVAL=3
# Use AI to decide when to close positions too
AI_CLOSE_DECISIONS=true

# Trading Settings
TRADING_SYMBOL=BTCUSDT
TRADING_LEVERAGE=20
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0
MIN_CONFIDENCE=65

# ── Progressive Profit Locking ──
# Replaces legacy breakeven/trailing/force-close
PROGRESSIVE_STOP_ENABLED=true
PROFIT_STEP_NET_USD=4.0
LOCK_STEP_NET_USD=1.0
TAKER_FEE_RATE=0.00055
SLIPPAGE_BUFFER_USD=0.40
MIN_STOP_IMPROVEMENT_USD=0.25
DISABLE_LEGACY_PROFIT_PROTECTION=true

# Mode: true = paper trading (no real money), false = live trading
PAPER_TRADING=true

# Dashboard
DASHBOARD_PORT=8001
LOG_LEVEL=INFO
